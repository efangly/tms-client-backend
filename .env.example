# Server Configuration
PORT=8080

# Database Configuration
DB_HOST=
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tms_std
DB_CHARSET=tis620

# Backup table archive script (script/main.go only) — name of a table with
# temp_log's schema to fold into the temp_log archive series, e.g. a table
# left over from a rename.
# BACKUP_TABLE_NAME=temp_log_backup

# Polling Configuration
POLL_INTERVAL=5m
ALERT_INTERVAL=5s

# Live log over SSE (GET /api/log-stream); false = route returns 404
LOG_STREAM_ENABLED=true

# Legacy API Configuration (for sending data every 5 minutes and alerts)
LEGACY_API_URL=
LEGACY_API_TOKEN=

MQTT_BROKER=
MQTT_PORT=
MQTT_CLIENT_ID=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=

# Build version (read by build.sh, baked into the exe; leave empty to use git describe)
VERSION=

# Report PDF header logo (PNG/JPEG). Default: assets/logo.png next to the exe
# LOGO_PATH=assets/logo.png

# Auto update from GitHub Releases (internal/updater). Release builds check
# every UPDATE_CHECK_INTERVAL, install a newer vX.Y.Z and restart; if the new
# version fails to start it is rolled back and skipped.
UPDATE_ENABLED=true
# UPDATE_REPO=efangly/tms-client-backend
# UPDATE_CHECK_INTERVAL=6h
# Only install inside this daily window (local time, may cross midnight);
# empty = any time. Updates also wait for running Report Jobs.
# UPDATE_WINDOW=02:00-04:00
